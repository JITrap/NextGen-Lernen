<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="lp-tiles section color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="lp-tiles__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <header class="lp-tiles__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="lp-tiles__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="lp-tiles__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="lp-tiles__grid" style="--lp-tiles-cols: {{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        {%- assign col = block.settings.collection -%}
        <a
          class="collection-card lp-tile"
          href="{{ col.url | default: '#' }}"
          aria-label="{{ col.title | default: 'Kollektion' | escape }}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.cover != blank -%}
            {{
              block.settings.cover
              | image_url: width: 1200
              | image_tag: widths: '400, 600, 900, 1200', sizes: '(min-width: 750px) 25vw, 50vw', alt: col.title, loading: 'lazy', class: 'lp-tile__img'
            }}
          {%- elsif col.featured_image -%}
            {{
              col.featured_image
              | image_url: width: 1200
              | image_tag: widths: '400, 600, 900, 1200', sizes: '(min-width: 750px) 25vw, 50vw', alt: col.title, loading: 'lazy', class: 'lp-tile__img'
            }}
          {%- endif -%}
          <span class="lp-tile__cta" aria-hidden="true">
            Entdecken
            <svg viewBox="0 0 20 20"><path d="M4 10h12m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .lp-tiles__inner {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: 0 24px;
  }
  .lp-tiles__header {
    margin-bottom: 28px;
  }
  .lp-tiles__eyebrow {
    margin: 0 0 10px;
    font-family: var(--font-subheading--family);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(from var(--color-foreground) r g b / 64%);
  }
  .lp-tiles__heading {
    margin: 0;
    font-family: var(--font-accent--family);
  }
  .lp-tiles__grid {
    display: grid;
    grid-template-columns: repeat(var(--lp-tiles-cols, 4), 1fr);
    gap: 10px 8px;
  }
  .lp-tile {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--lp-carbon, #0B0B0C);
  }
  .lp-tile__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .lp-tile__cta {
    position: absolute;
    left: 14px;
    bottom: 12px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-accent--family);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #FCFBF7;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .lp-tile__cta svg {
    width: 15px;
    height: 15px;
  }
  .lp-tile:hover .lp-tile__cta,
  .lp-tile:focus-visible .lp-tile__cta {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .lp-tile__cta { transition: none; transform: none; }
  }
  @media screen and (max-width: 749px) {
    .lp-tiles__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

{% schema %}
{
  "name": "Kategorie-Kacheln",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "ACHT KOLLEKTIONEN" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Finde deinen Stil" },
    { "type": "range", "id": "columns", "label": "Spalten (Desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Farbschema", "default": "scheme-1" },
    { "type": "range", "id": "padding-block-start", "label": "Abstand oben", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding-block-end", "label": "Abstand unten", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Kachel",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Kollektion" },
        { "type": "image_picker", "id": "cover", "label": "Cover-Bild (überschreibt Kollektionsbild)" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [{ "name": "Kategorie-Kacheln" }]
}
{% endschema %}
