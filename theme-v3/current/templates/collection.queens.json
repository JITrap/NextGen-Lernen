      "settings": {
        "custom_liquid": "<style>\n  /* — QUEENS: rose base accents — */\n  main[data-template=\"collection.queens\"] { --lp-cobalt: #B0526B; --lp-cobalt-bright: #E4A7B6; }\n  main[data-template=\"collection.queens\"] .price { color: #B0526B; }\n  main[data-template=\"collection.queens\"] h1 { position: relative; z-index: 1; }\n  main[data-template=\"collection.queens\"] h1::after { content: \"\"; display: block; width: 64px; height: 4px; background: #E4A7B6; margin-top: 12px; }\n  main[data-template=\"collection.queens\"] product-card:hover .card-gallery,\n  main[data-template=\"collection.queens\"] product-card:hover .product-card__gallery { box-shadow: 0 0 0 1px rgba(228, 167, 182, 0.55), 0 18px 36px rgba(11, 11, 12, 0.12); }\n\n  /* — rose hover/focus statt Cobalt (nur diese Seite) — */\n  main[data-template=\"collection.queens\"] a:hover { color: #B0526B; }\n  main[data-template=\"collection.queens\"] :is(a, button, summary, select, input):focus-visible { outline-color: #B0526B; }\n\n  /* Sections dieser Vorlage sind alle scheme-1 (Papier wie der Body):\n     transparent stellen, damit die Deko-Ebene (z-index:-1) sichtbar ist. */\n  main[data-template=\"collection.queens\"] .section,\n  main[data-template=\"collection.queens\"] .section-background { background-color: transparent; }\n\n  /* — Deko-Ebene: hinter allem Inhalt, vor dem Papier — */\n  main[data-template=\"collection.queens\"] .queens-decor { position: absolute; pointer-events: none; z-index: -1; }\n  main[data-template=\"collection.queens\"] .queens-lily { top: 0; right: 0; width: 292px; height: auto; }\n  main[data-template=\"collection.queens\"] .queens-wash {\n    top: 60px; right: 0; width: min(880px, 96vw); height: 680px;\n    background: radial-gradient(ellipse 62% 36% at 84% 38%, rgba(228, 167, 182, 0.12) 0%, rgba(228, 167, 182, 0.06) 45%, rgba(228, 167, 182, 0.02) 66%, rgba(228, 167, 182, 0) 82%);\n  }\n  main[data-template=\"collection.queens\"] .queens-petal { opacity: 0.05; }\n  main[data-template=\"collection.queens\"] .queens-petal--a { top: 620px; left: 3vw; height: 380px; width: auto; transform: rotate(-24deg); }\n  main[data-template=\"collection.queens\"] .queens-petal--b { top: 1010px; right: 7vw; height: 330px; width: auto; transform: rotate(21deg); }\n  @media (max-width: 749px) {\n    main[data-template=\"collection.queens\"] .queens-lily { width: 155px; }\n    main[data-template=\"collection.queens\"] .queens-wash { top: 30px; height: 500px; }\n    main[data-template=\"collection.queens\"] .queens-petal--a { top: 560px; left: -34px; height: 280px; }\n    main[data-template=\"collection.queens\"] .queens-petal--b { top: 960px; right: -26px; height: 250px; }\n  }\n  @media (prefers-reduced-motion: no-preference) {\n    main[data-template=\"collection.queens\"] .queens-lily-sway {\n      transform-box: fill-box; transform-origin: 86% 98%;\n      animation: queensLilySway 6s ease-in-out infinite alternate;\n    }\n    @keyframes queensLilySway { from { transform: rotate(-0.6deg); } to { transform: rotate(0.6deg); } }\n  }\n</style>\n<svg class=\"queens-decor queens-lily\" viewBox=\"0 22 378 538\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n  <defs>\n    <path id=\"queensTepalB\" d=\"M 0 0 C -12 -16, -25 -40, -26 -66 C -27 -90, -17 -108, -3 -119 C -1 -121, 1 -121, 3 -119 C 17 -108, 27 -90, 26 -64 C 25 -40, 12 -16, 0 0 Z\"/>\n    <path id=\"queensTepalBv\" d=\"M 0 -14 C -3 -40, -3 -78, -1 -106\"/>\n    <path id=\"queensTepalF\" d=\"M 0 0 C -14 -14, -28 -36, -30 -62 C -32 -88, -20 -108, -4 -120 C -1 -122, 2 -122, 4 -119 C 19 -107, 30 -88, 29 -62 C 28 -36, 14 -14, 0 0 Z\"/>\n    <path id=\"queensTepalFv\" d=\"M 0 -16 C -4 -42, -4 -80, -1 -108\"/>\n  </defs>\n  <g class=\"queens-lily-sway\">\n    <path d=\"M 434 556 C 386 472, 336 382, 304 302 C 282 246, 260 200, 240 170\" stroke=\"#B0526B\" stroke-width=\"2.6\" stroke-linecap=\"round\"/>\n    <path d=\"M 272 242 C 296 210, 308 160, 312 108\" stroke=\"#B0526B\" stroke