        "custom_liquid": "<style>\n  /* — QUEENS: rose base accents — */\n  main[data-template=\"collection.queens\"] { --lp-cobalt: #B0526B; --lp-cobalt-bright: #E4A7B6; }\n  main[data-template=\"collection.queens\"] .price { color: #B0526B; }\n  main[data-template=\"collection.queens\"] h1 { position: relative; z-index: 1; }\n  main[data-template=\"collection.queens\"] h1::after { content: \"\"; display: block; width: 64px; height: 4px; background: #E4A7B6; margin-top: 12px; }\n  main[data-template=\"collection.queens\"] product-card:hover .card-gallery,\n  main[data-template=\"collection.queens\"] product-card:hover .product-card__gallery { box-shadow: 0 0 0 1px rgba(228, 167, 182, 0.55), 0 18px 36px rgba(11, 11, 12, 0.12); }\n\n  /* — rose hover/focus statt Cobalt (nur diese Seite) — */\n  main[data-template=\"collection.queens\"] a:hover { color: #B0526B; }\n  main[data-template=\"collection.queens\"] :is(a, button, summary, select, input):focus-visible { outline-color: #B0526B; }\n\n  /* Sections dieser Vorlage sind alle scheme-1 (Papier wie der Body):\n     transparent stellen, damit die Deko-Ebene (z-index:-1) sichtbar ist. */\n  main[data-template=\"collection.queens\"] .section,\n  main[data-template=\"collection.queens\"] .section-background { background-color: transparent; }\n\n  /* — Deko-Ebene: hinter allem Inhalt, vor dem Papier — */\n  main[data-template=\"collection.queens\"] .queens-decor { position: absolute; pointer-events: none; z-index: -1; }\n  main[data-template=\"collection.queens\"] .queens-lily { top: 0; right: 0; width: min(340px, 30vw); height: auto; }\n  main[data-template=\"collection.queens\"] .queens-wash {\n    top: 60px; right: 0; width: min(880px, 96vw); height: 680px;\n    background: radial-gradient(ellipse 62% 36% at 84% 38%, rgba(228, 167, 182, 0.12) 0%, rgba(228, 167, 182, 0.06) 45%, rgba(228, 167, 182, 0.02) 66%, rgba(228, 167, 182, 0) 82%);\n  }\n  main[data-template=\"collection.queens\"] .queens-petal { opacity: 0.05; }\n  main[data-template=\"collection.queens\"] .queens-petal--a { top: 620px; left: 3vw; height: 380px; width: auto; transform: rotate(-24deg); }\n  main[data-template=\"collection.queens\"] .queens-petal--b { top: 1010px; right: 7vw; height: 330px; width: auto; transform: rotate(21deg); }\n  @media (max-width: 749px) {\n    main[data-template=\"collection.queens\"] .queens-lily { width: 180px; }\n    main[data-template=\"collection.queens\"] .queens-wash { top: 30px; height: 500px; }\n    main[data-template=\"collection.queens\"] .queens-petal--a { top: 560px; left: -34px; height: 280px; }\n    main[data-template=\"collection.queens\"] .queens-petal--b { top: 960px; right: -26px; height: 250px; }\n  }\n  @media (prefers-reduced-motion: no-preference) {\n    main[data-template=\"collection.queens\"] .queens-lily-sway {\n      transform-box: fill-box; transform-origin: 86% 98%;\n      animation: queensLilySway 6s ease-in-out infinite alternate;\n    }\n    @keyframes queensLilySway { from { transform: rotate(-0.6deg); } to { transform: rotate(0.6deg); } }\n  }\n</style>\n<img class=\"queens-decor queens-lily\" src=\"https://cdn.shopify.com/s/files/1/0976/9979/1181/files/lp-queens-lily.png?v=1786110643\" alt=\"\" aria-hidden=\"true\" loading=\"lazy\" width=\"700\" height=\"635\">\n\n\n<div class=\"queens-decor queens-wash\" aria-hidden=\"true\"></div>",
