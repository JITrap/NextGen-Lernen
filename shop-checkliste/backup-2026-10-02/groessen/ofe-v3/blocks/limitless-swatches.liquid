{%- doc -%}
  CARD-03 · Rahmen-Punkte auf Produktkarten: zeigt die Farb-Option
  (Black/White) als runde Swatches — ohne Admin-Farbmuster-Konfiguration.
  Bekannte Namen werden direkt auf Hex gemappt; falls Shopify-Swatch-Daten
  existieren, haben diese Vorrang. Unbekannte Werte erscheinen als Text.
{%- enddoc -%}

{%- liquid
  assign sw_product = closest.product
-%}
{%- if sw_product != blank -%}
  {%- for option in sw_product.options_with_values -%}
    {%- assign oname = option.name | downcase -%}
    {%- if oname == 'color' or oname == 'colour' or oname == 'farbe' -%}
      <div class="lp-swatches" {{ block.shopify_attributes }} aria-label="Verfügbare Rahmenfarben">
        {%- for value in option.values -%}
          {%- assign vname = value.name | downcase -%}
          {%- assign hex = '' -%}
          {%- if value.swatch and value.swatch.color -%}
            {%- assign hex = value.swatch.color -%}
          {%- elsif vname == 'black' or vname == 'schwarz' -%}
            {%- assign hex = '#1A1A1A' -%}
          {%- elsif vname == 'white' or vname == 'weiß' or vname == 'weiss' -%}
            {%- assign hex = '#F6F5F1' -%}
          {%- endif -%}
          {%- if hex != '' -%}
            <span class="lp-swatch" style="--lp-swatch-color: {{ hex }};" title="{{ value.name | escape }}"></span>
          {%- else -%}
            <span class="lp-swatch lp-swatch--text">{{ value.name | escape }}</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if block.settings.label != blank -%}
          <span class="lp-swatches__label">{{ block.settings.label | escape }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{% stylesheet %}
  .lp-swatches {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-top: 6px;
  }
  .lp-swatch {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--lp-swatch-color, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-foreground) 28%, transparent);
    flex: none;
  }
  .lp-swatch--text {
    width: auto;
    height: auto;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 0.625rem;
    background: color-mix(in srgb, var(--color-foreground) 8%, transparent);
    box-shadow: none;
  }
  .lp-swatches__label {
    font-family: var(--font-subheading--family);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-foreground) 55%, transparent);
    margin-left: 2px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Rahmen-Punkte",
  "tag": null,
  "settings": [
    { "type": "text", "id": "label", "label": "Beschriftung", "default": "2 Rahmen" }
  ],
  "presets": [{ "name": "Rahmen-Punkte" }]
}
{% endschema %}
