{%- assign sp = section.settings.product -%}
{%- assign photo = section.settings.photo -%}
{%- assign has_real_photo = false -%}
{%- if photo != blank -%}
  {%- assign has_real_photo = true -%}
{%- endif -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="lp-reallook color-{{ section.settings.color_scheme }}{% unless has_real_photo %} lp-reallook--mockup{% endunless %}"
  style="--lp-reallook-pt: {{ section.settings.padding-block-start }}px; --lp-reallook-pb: {{ section.settings.padding-block-end }}px;"
>
  <div class="lp-reallook__inner">
    <div class="lp-reallook__photo-col">
      <div class="lp-reallook__photo-wrap lp-fd">
        {%- if sp != blank -%}<a href="{{ sp.url }}" class="lp-reallook__photo" aria-label="{{ sp.title | escape }}">{%- else -%}<span class="lp-reallook__photo">{%- endif -%}
          {%- if has_real_photo -%}
            {%- assign photo_style = 'aspect-ratio: ' | append: photo.aspect_ratio -%}
            {{ photo | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', class: 'lp-reallook__img', style: photo_style }}
          {%- elsif sp != blank and sp.featured_image != blank -%}
            {%- assign fallback_style = 'aspect-ratio: ' | append: sp.featured_image.aspect_ratio -%}
            {{ sp.featured_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', class: 'lp-reallook__img', style: fallback_style }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'lp-reallook__img' }}
          {%- endif -%}
          {%- if has_real_photo and section.settings.show_badge and section.settings.badge_label != blank -%}
            <span class="lp-reallook__badge">{{ section.settings.badge_label | escape }}</span>
          {%- endif -%}
        {%- if sp != blank -%}</a>{%- else -%}</span>{%- endif -%}
        <svg class="lp-reallook__fd-frame lp-fd-frame" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><rect x="0.75" y="0.75" width="98.5" height="98.5" pathLength="1"/></svg>
      </div>
      {%- if request.design_mode and has_real_photo == false -%}
        <p class="lp-reallook__editor-hint">Platzhalter: Produktbild. Lade unter „Foto (real)" das echte Wandfoto hoch.</p>
      {%- endif -%}
    </div>

    <div class="lp-reallook__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="lp-reallook__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="lp-reallook__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="lp-reallook__text">{{ section.settings.text }}</div>
      {%- endif -%}

      <ul class="lp-reallook__checks" role="list">
        {%- for i in (1..3) -%}
          {%- assign check_key = 'check_' | append: i -%}
          {%- assign check_text = section.settings[check_key] -%}
          {%- if check_text != blank -%}
            <li>
              <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2.5 8.5 6 12l7.5-8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span>{{ check_text | escape }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- if sp != blank -%}
        <div class="lp-reallook__product">
          {%- if sp.featured_image != blank -%}
            <a class="lp-reallook__thumb" href="{{ sp.url }}" aria-hidden="true" tabindex="-1">
              {{ sp.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', class: 'lp-reallook__thumb-img', alt: '' }}
            </a>
          {%- endif -%}
          <div class="lp-reallook__product-meta">
            <a class="lp-reallook__product-title" href="{{ sp.url }}">{{ sp.title | escape }}</a>
            <span class="lp-reallook__product-price">{{ sp.price | money }}</span>
          </div>
          <a class="button-secondary lp-reallook__cta" href="{{ sp.url }}">{{ section.settings.cta_label | default: 'Poster ansehen' | escape }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .lp-reallook {
    padding-block-start: var(--lp-reallook-pt, 72px);
    padding-block-end: var(--lp-reallook-pb, 72px);
    padding-inline: max(24px, calc((100% - var(--normal-content-width, 1300px)) / 2));
  }
  .lp-reallook__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr);
    gap: clamp(32px, 5.5vw, 84px);
    align-items: center;
  }
  .lp-reallook__photo-wrap {
    position: relative;
    margin-inline: clamp(8px, 1.6vw, 22px);
  }
  .lp-reallook__photo {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--lp-ivory, #F4F1EA);
    box-shadow: 0 32px 70px rgba(11, 11, 12, 0.45);
    transform: rotate(-1.2deg);
    transition: transform 0.4s ease;
  }
  .lp-reallook__photo:hover { transform: rotate(0deg); }
  .lp-reallook__img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 76svh;
    object-fit: cover;
  }
  /* Solange nur das Mockup da ist: Wandfarbe des Renderings in die Panelfarbe einblenden */
  .lp-reallook--mockup .lp-reallook__img {
    mix-blend-mode: multiply;
    filter: brightness(1.06);
  }
  .lp-reallook__badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 1;
    background: var(--lp-paper, #FCFBF7);
    color: var(--lp-carbon, #0B0B0C);
    font-family: var(--font-accent--family);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 7px 11px;
    box-shadow: 0 4px 14px rgba(11, 11, 12, 0.25);
  }
  .lp-reallook__fd-frame {
    position: absolute;
    inset: -14px;
    width: calc(100% + 28px);
    height: calc(100% + 28px);
    color: var(--lp-cobalt, #3157FF);
    pointer-events: none;
  }
  .lp-reallook__fd-frame rect {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1s ease-out 0.2s;
  }
  .lp-fd.lp-fd-visible .lp-reallook__fd-frame rect { stroke-dashoffset: 0; }
  @media (prefers-reduced-motion: reduce) {
    .lp-reallook__fd-frame rect { stroke-dashoffset: 0; transition: none; }
    .lp-reallook__photo { transform: none; }
  }
  .lp-reallook__editor-hint {
    margin: 14px 0 0;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    opacity: 0.6;
  }
  .lp-reallook__eyebrow {
    margin: 0 0 12px;
    font-family: var(--font-subheading--family);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(from var(--color-foreground) r g b / 70%);
  }
  .lp-reallook__heading {
    margin: 0 0 14px;
    font-family: var(--font-accent--family);
    font-size: clamp(1.7rem, 3.4vw, 2.6rem);
    letter-spacing: -0.015em;
    color: var(--color-foreground-heading, var(--color-foreground));
  }
  .lp-reallook__text { max-width: 46ch; }
  .lp-reallook__text p { margin: 0 0 10px; line-height: 1.6; }
  .lp-reallook__checks {
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .lp-reallook__checks li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 0.9375rem;
  }
  .lp-reallook__checks svg {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    color: var(--lp-cobalt, #3157FF);
    transform: translateY(1px);
  }
  .lp-reallook__product {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 30px;
    padding: 14px;
    border: 1px solid rgb(from var(--color-foreground) r g b / 16%);
  }
  .lp-reallook__thumb {
    display: block;
    width: 58px;
    flex-shrink: 0;
    background: var(--lp-ivory, #F4F1EA);
  }
  .lp-reallook__thumb-img {
    display: block;
    width: 100%;
    height: auto;
    mix-blend-mode: multiply;
    filter: brightness(1.06);
  }
  .lp-reallook__product-meta {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .lp-reallook__product-title {
    color: var(--color-foreground);
    text-decoration: none;
    font-size: 0.9375rem;
    line-height: 1.35;
  }
  .lp-reallook__product-title:hover { color: var(--color-primary-hover); text-decoration: underline; }
  .lp-reallook__product-price {
    font-family: var(--font-subheading--family);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    color: rgb(from var(--color-foreground) r g b / 75%);
  }
  .lp-reallook__cta { margin-left: auto; }
  @media (max-width: 899px) {
    .lp-reallook__inner { grid-template-columns: 1fr; gap: 40px; }
    .lp-reallook__photo-wrap { margin-inline: 10px; }
    .lp-reallook__cta { margin-left: 0; width: 100%; text-align: center; }
  }
</style>

{% schema %}
{
  "name": "Real-Look (Poster in echt)",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "image_picker", "id": "photo", "label": "Foto (real)", "info": "Echtes Foto des Posters an der Wand. Ohne Foto wird das Produktbild als Platzhalter gezeigt." },
    { "type": "product", "id": "product", "label": "Poster" },
    { "type": "checkbox", "id": "show_badge", "label": "Badge „echtes Foto\" zeigen", "default": true },
    { "type": "text", "id": "badge_label", "label": "Badge-Text", "default": "100 % echtes Foto" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "REAL LOOK" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "So sieht es in echt aus." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Kein Rendering, kein Studio-Trick: So wirkt das Poster an einer echten Wand — mattes Museumspapier, klarer schwarzer Rahmen, satte Farben.</p>" },
    { "type": "text", "id": "check_1", "label": "Punkt 1", "default": "Gerahmt geliefert — sofort aufhängbar" },
    { "type": "text", "id": "check_2", "label": "Punkt 2", "default": "Mattes Papier in Museumsqualität" },
    { "type": "text", "id": "check_3", "label": "Punkt 3", "default": "Farben wie im echten Druck" },
    { "type": "text", "id": "cta_label", "label": "Button-Text", "default": "Poster ansehen" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Farbschema", "default": "scheme-3" },
    { "type": "range", "id": "padding-block-start", "label": "Abstand oben", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding-block-end", "label": "Abstand unten", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [{ "name": "Real-Look (Poster in echt)" }]
}
{% endschema %}
