{%- doc -%}
  CNV-05 · Trust-Leiste: vier Vertrauens-Anker mit Icons.
  Einsetzbar auf der Produktseite (unter dem Kauf-Button) oder in Sections.
{%- enddoc -%}

<div class="lp-trust" {{ block.shopify_attributes }}>
  <div class="lp-trust__item">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M1 8h13v9H1zM14 11h4l3 3v3h-7z"/><circle cx="5.5" cy="18.5" r="1.8"/><circle cx="17.5" cy="18.5" r="1.8"/></svg>
    <span class="lp-trust__title">{{ block.settings.title_1 | escape }}</span>
    <span class="lp-trust__sub">{{ block.settings.sub_1 | escape }}</span>
  </div>
  <div class="lp-trust__item">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l8 3v6c0 4.5-3.2 7.6-8 9-4.8-1.4-8-4.5-8-9V6z"/><path d="M8.8 12.2l2.2 2.2 4.2-4.6"/></svg>
    <span class="lp-trust__title">{{ block.settings.title_2 | escape }}</span>
    <span class="lp-trust__sub">{{ block.settings.sub_2 | escape }}</span>
  </div>
  <div class="lp-trust__item">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 2.6-6.3"/><path d="M3 4v5h5"/></svg>
    <span class="lp-trust__title">{{ block.settings.title_3 | escape }}</span>
    <span class="lp-trust__sub">{{ block.settings.sub_3 | escape }}</span>
  </div>
  <div class="lp-trust__item">
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
    <span class="lp-trust__title">{{ block.settings.title_4 | escape }}</span>
    <span class="lp-trust__sub">{{ block.settings.sub_4 | escape }}</span>
  </div>
</div>

{% schema %}
{
  "name": "Trust-Leiste",
  "tag": null,
  "settings": [
    { "type": "text", "id": "title_1", "label": "Titel 1", "default": "Gerahmt geliefert" },
    { "type": "text", "id": "sub_1", "label": "Untertitel 1", "default": "sofort aufhängbar" },
    { "type": "text", "id": "title_2", "label": "Titel 2", "default": "Käuferschutz" },
    { "type": "text", "id": "sub_2", "label": "Untertitel 2", "default": "sicher bezahlen" },
    { "type": "text", "id": "title_3", "label": "Titel 3", "default": "14 Tage Widerruf" },
    { "type": "text", "id": "sub_3", "label": "Untertitel 3", "default": "ohne Wenn und Aber" },
    { "type": "text", "id": "title_4", "label": "Titel 4", "default": "SSL-verschlüsselt" },
    { "type": "text", "id": "sub_4", "label": "Untertitel 4", "default": "deine Daten sind sicher" }
  ],
  "presets": [{ "name": "Trust-Leiste" }]
}
{% endschema %}
