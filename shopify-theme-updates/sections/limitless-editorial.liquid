{%- doc -%}
  Editorial-Split: Text links, rechts NUR das Produkt (Rahmen + Motiv,
  tight-Crop via limitless-media — kein Creme-Mockup-Rand, kein heller
  Kasten) mit dezentem Schatten auf dem Scheme-Grund. Darunter optional
  drei Kennzahlen-Paare (löst die frühere Stats-Zähler-Sektion ab).
  Ersetzt die Horizon media-with-content-Instanz auf der Startseite.
{%- enddoc -%}

{%- liquid
  assign lp_product = section.settings.product
  assign lp_link_url = section.settings.link | default: '/pages/story'
-%}

<div
  class="lp-edit color-{{ section.settings.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <div class="lp-edit__inner">
    <div class="lp-edit__grid">
      <div class="lp-edit__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="lp-edit__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="lp-edit__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="lp-edit__text">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.link_label != blank -%}
          <a class="lp-edit__link" href="{{ lp_link_url }}">
            {{- section.settings.link_label | escape -}}
            <span aria-hidden="true">→</span>
          </a>
        {%- endif -%}
        {%- capture lp_stats -%}
          {%- for i in (1..3) -%}
            {%- assign lp_stat_n_key = 'stat_' | append: i | append: '_n' -%}
            {%- assign lp_stat_l_key = 'stat_' | append: i | append: '_l' -%}
            {%- assign lp_stat_n = section.settings[lp_stat_n_key] -%}
            {%- if lp_stat_n != blank -%}
              <div class="lp-edit__stat">
                <span class="lp-edit__stat-n">{{ lp_stat_n | escape }}</span>
                {%- assign lp_stat_l = section.settings[lp_stat_l_key] -%}
                {%- if lp_stat_l != blank -%}
                  <span class="lp-edit__stat-l">{{ lp_stat_l | escape }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if lp_stats != blank -%}
          <div class="lp-edit__stats">
            {{ lp_stats }}
          </div>
        {%- endif -%}
      </div>
      <div class="lp-edit__media">
        {%- if lp_product != blank -%}
          <a class="lp-edit__media-link" href="{{ lp_product.url }}" aria-label="{{ lp_product.title | escape }}">
            {% render 'limitless-media', product: lp_product, kind: 'hero', preset: 'tight', width: 900, widths: '480, 720, 900', sizes: '(min-width: 750px) 45vw, 90vw', class: 'lp-edit__img', loading: 'lazy' %}
          </a>
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'lp-edit__img' }}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<style>
  .lp-edit { position: relative; }
  .lp-edit > .section-background { z-index: -1; }
  .lp-edit__inner {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: 0 24px;
  }
  .lp-edit__grid {
    display: grid;
    gap: 36px;
    align-items: center;
  }
  .lp-edit__eyebrow {
    margin: 0 0 12px;
    font-family: var(--font-subheading--family);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--lp-cobalt-bright, #E4A7B6);
  }
  .lp-edit__heading {
    margin: 0 0 16px;
    font-family: var(--font-accent--family);
    font-size: clamp(1.9rem, 3.8vw, 2.9rem);
    line-height: 1.12;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .lp-edit__text {
    max-width: 52ch;
    color: color-mix(in srgb, var(--color-foreground) 78%, transparent);
  }
  .lp-edit__text > p { margin-block: 0 0.7em; }
  .lp-edit__text > p:last-child { margin-block-end: 0; }
  .lp-edit__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 20px;
    color: var(--color-foreground);
    font-weight: 500;
    text-decoration: none;
  }
  .lp-edit__link:hover { text-decoration: underline; text-underline-offset: 3px; }
  .lp-edit__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: 32px;
    padding-top: 22px;
    border-top: 1px solid color-mix(in srgb, var(--color-foreground) 12%, transparent);
  }
  .lp-edit__stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .lp-edit__stat-n {
    font-family: var(--font-accent--family);
    font-size: 1.375rem;
    letter-spacing: -0.01em;
    color: var(--color-foreground-heading, var(--color-foreground));
  }
  .lp-edit__stat-l {
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: color-mix(in srgb, var(--color-foreground) 62%, transparent);
  }
  .lp-edit__media {
    width: 100%;
    max-width: 300px;
    margin: 0 auto;
  }
  .lp-edit__media-link { display: block; }
  .lp-edit__img {
    display: block;
    width: 100%;
    height: auto;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4);
  }

  @media (min-width: 750px) {
    .lp-edit__grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: clamp(40px, 6vw, 72px);
    }
    .lp-edit__media { max-width: 420px; }
  }
</style>

{% schema %}
{
  "name": "Limitless Editorial",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "product", "id": "product", "label": "Produkt" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "UNSERE LINIE" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Ein Rahmen. Ein Anspruch." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Ein durchgängiger Look statt Zufallsdeko: Museumsqualität im schwarzen oder weißen Rahmen, aufhängfertig geliefert und gedruckt in der EU.</p>" },
    { "type": "text", "id": "link_label", "label": "Link-Text", "default": "Mehr erfahren" },
    { "type": "url", "id": "link", "label": "Link-Ziel" },
    { "type": "text", "id": "stat_1_n", "label": "Kennzahl 1 (Zahl)", "default": "14 Tage" },
    { "type": "text", "id": "stat_1_l", "label": "Kennzahl 1 (Label)", "default": "Widerrufsrecht" },
    { "type": "text", "id": "stat_2_n", "label": "Kennzahl 2 (Zahl)", "default": "2 Jahre" },
    { "type": "text", "id": "stat_2_l", "label": "Kennzahl 2 (Label)", "default": "Gewährleistung" },
    { "type": "text", "id": "stat_3_n", "label": "Kennzahl 3 (Zahl)", "default": "99" },
    { "type": "text", "id": "stat_3_l", "label": "Kennzahl 3 (Label)", "default": "Kuratierte Motive" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Farbschema", "default": "scheme-3" },
    { "type": "range", "id": "padding-block-start", "label": "Abstand oben", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding-block-end", "label": "Abstand unten", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [
    { "name": "Limitless Editorial" }
  ]
}
{% endschema %}
