{%- doc -%}
  PAGE-01 · Gallery-Wall-Konfigurator: Layout wählen (2er-Reihe, 3er-Reihe,
  2×2), Slots per Klick mit Postern aus der Kollektion füllen, Größe je
  Poster wählen, komplette Wand mit einem Klick in den Warenkorb
  (POST /cart/add.js). Produktdaten kommen serverseitig als JSON aus
  Liquid; das Skript baut alle Knoten per createElement/textContent —
  kein HTML aus Daten, kein Injection-Risiko.
{%- enddoc -%}

{%- liquid
  assign gw_products = section.settings.collection.products
  if gw_products.size == 0
    assign gw_products = collections.all.products
  endif
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="lp-gw section spacing-style color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-lp-gw
>
  <script type="application/json" data-lp-gw-data>
    [
      {%- assign gw_first = true -%}
      {%- for product in gw_products limit: 12 -%}
        {%- if product.available and product.media.size > 0 -%}
          {%- unless gw_first %},{% endunless -%}
          {%- assign gw_first = false -%}
          {%- capture lm_u -%}{% render 'limitless-media', product: product, kind: 'hero', preset: 'tight', output: 'url', width: 300 %}{%- endcapture -%}
          {
            "title": {{ product.title | json }},
            "url": {{ product.url | json }},
            "image": {{ lm_u | strip | json }},
            "variants": [
              {%- for variant in product.variants -%}
                {%- if variant.available -%}
                  { "id": {{ variant.id | json }}, "title": {{ variant.title | json }}, "price": {{ variant.price | json }} }{%- unless forloop.last %},{% endunless -%}
                {%- endif -%}
              {%- endfor -%}
            ]
          }
        {%- endif -%}
      {%- endfor -%}
    ]
  </script>

  <div class="lp-gw__inner">
    <div class="lp-gw__head">
      <p class="lp-gw__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1 class="lp-gw__heading">{{ section.settings.heading | escape }}</h1>
      <p class="lp-gw__sub">{{ section.settings.subheading | escape }}</p>
    </div>

    <div class="lp-gw__layouts" role="group" aria-label="Wand-Layout wählen">
      <button class="lp-gw__layout" type="button" data-lp-gw-layout="row2" aria-pressed="true">2er-Reihe</button>
      <button class="lp-gw__layout" type="button" data-lp-gw-layout="row3" aria-pressed="false">3er-Reihe</button>
      <button class="lp-gw__layout" type="button" data-lp-gw-layout="grid4" aria-pressed="false">2 × 2</button>
    </div>

    <div class="lp-gw__wall-wrap">
      <div class="lp-gw__wall lp-gw__wall--row2" data-lp-gw-wall>
        <div class="lp-gw__slots" data-lp-gw-slots></div>
        <div class="lp-gw__sofa" aria-hidden="true"><span class="back"></span><span class="seat"></span></div>
      </div>

      <div class="lp-gw__picker" data-lp-gw-picker hidden role="dialog" aria-modal="false" aria-label="Poster wählen">
        <div class="lp-gw__picker-head">
          <span>Poster für diesen Platz wählen</span>
          <button class="lp-gw__picker-close" type="button" data-lp-gw-picker-close aria-label="Auswahl schließen">✕</button>
        </div>
        <div class="lp-gw__picker-grid" data-lp-gw-picker-grid></div>
      </div>
    </div>

    <div class="lp-gw__summary" data-lp-gw-summary hidden>
      <div class="lp-gw__rows" data-lp-gw-rows></div>
      <div class="lp-gw__foot">
        <div class="lp-gw__total">Gesamt <strong data-lp-gw-total>0,00 €</strong></div>
        <button class="button lp-gw__cta" type="button" data-lp-gw-add disabled>Wand in den Warenkorb</button>
      </div>
      <p class="lp-gw__note">{{ section.settings.note | escape }}</p>
    </div>
    <p class="lp-gw__status" data-lp-gw-status role="status" aria-live="polite"></p>
  </div>
</div>

<style>
  .lp-gw__inner { max-width: 920px; margin: 0 auto; padding: 0 24px; }
  .lp-gw__head { text-align: center; margin-bottom: 26px; }
  .lp-gw__eyebrow { margin: 0 0 10px; font-family: var(--font-subheading--family); font-size: 0.6875rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--lp-cobalt-bright, #E4A7B6); }
  .lp-gw__heading { margin: 0 0 12px; font-family: var(--font-accent--family); letter-spacing: -0.015em; font-size: clamp(2rem, 5vw, 3.2rem); }
  .lp-gw__sub { margin: 0 auto; max-width: 52ch; font-size: 0.9375rem; color: color-mix(in srgb, var(--color-foreground) 68%, transparent); }
  .lp-gw__layouts { display: flex; justify-content: center; gap: 8px; margin-bottom: 20px; flex-wrap: wrap; }
  .lp-gw__layout { border: 1.5px solid color-mix(in srgb, var(--color-foreground) 18%, transparent); background: transparent; color: var(--color-foreground); cursor: pointer; font-family: var(--font-subheading--family); font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 9px 16px; border-radius: 999px; transition: border-color 0.25s, background-color 0.25s, color 0.25s, transform 0.2s; }
  .lp-gw__layout:hover { transform: translateY(-1px); }
  .lp-gw__layout[aria-pressed='true'] { background: var(--color-foreground); color: var(--color-background); border-color: var(--color-foreground); }
  .lp-gw__wall-wrap { position: relative; }
  .lp-gw__wall { position: relative; border-radius: 16px; overflow: hidden; background: linear-gradient(180deg, #211B1D 0%, #191316 70%, #120D10 70%, #171114 100%); aspect-ratio: 16 / 9; box-shadow: inset 0 0 0 1px rgba(244, 237, 234, 0.08); }
  .lp-gw__slots { position: absolute; left: 50%; top: 42%; transform: translate(-50%, -50%); display: grid; gap: clamp(10px, 2vw, 22px); }
  .lp-gw__wall--row2 .lp-gw__slots { grid-template-columns: repeat(2, 1fr); }
  .lp-gw__wall--row3 .lp-gw__slots { grid-template-columns: repeat(3, 1fr); }
  .lp-gw__wall--grid4 .lp-gw__slots { grid-template-columns: repeat(2, 1fr); top: 40%; }
  .lp-gw__slot { position: relative; width: clamp(74px, 13vw, 122px); aspect-ratio: 3 / 4; border: 2px dashed rgba(244, 237, 234, 0.35); border-radius: 3px; background: rgba(244, 237, 234, 0.04); cursor: pointer; padding: 0; display: grid; place-items: center; transition: border-color 0.25s, background-color 0.25s, transform 0.25s; }
  .lp-gw__wall--grid4 .lp-gw__slot { width: clamp(58px, 9.5vw, 92px); }
  .lp-gw__slot:hover { border-color: var(--lp-cobalt-bright, #E4A7B6); transform: translateY(-2px); }
  .lp-gw__slot-plus { color: rgba(244, 237, 234, 0.55); font-size: 22px; line-height: 1; pointer-events: none; }
  .lp-gw__slot--filled { border: 5px solid #100C0E; outline: 1px solid rgba(244, 237, 234, 0.2); background: #100C0E; box-shadow: 0 14px 30px rgba(0, 0, 0, 0.55); overflow: hidden; }
  .lp-gw__slot img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .lp-gw__slot-x { position: absolute; top: -9px; right: -9px; width: 22px; height: 22px; border-radius: 50%; border: 0; cursor: pointer; background: var(--lp-cobalt, #A32235); color: #fff; font-size: 11px; line-height: 1; display: grid; place-items: center; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5); }
  .lp-gw__sofa { position: absolute; left: 50%; bottom: 8%; transform: translateX(-50%); width: 44%; height: 15%; pointer-events: none; }
  .lp-gw__sofa .back { position: absolute; inset: 0 4% 44%; background: #2E2620; border-radius: 8px 8px 0 0; display: block; }
  .lp-gw__sofa .seat { position: absolute; inset: 52% 0 18%; background: #372D25; border-radius: 8px; display: block; }
  .lp-gw__picker { position: absolute; inset: 6% 4%; z-index: 5; display: flex; flex-direction: column; background: #171114F2; -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); border: 1px solid rgba(244, 237, 234, 0.14); border-radius: 14px; box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6); }
  .lp-gw__picker-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 16px 10px; color: #F4EDEA; font-family: var(--font-subheading--family); font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  .lp-gw__picker-close { width: 28px; height: 28px; border-radius: 999px; border: 0; cursor: pointer; background: rgba(244, 237, 234, 0.1); color: #F4EDEA; font-size: 13px; line-height: 1; }
  .lp-gw__picker-grid { overflow-y: auto; display: grid; grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)); gap: 10px; padding: 4px 16px 16px; scrollbar-width: thin; }
  .lp-gw__pick { border: 0; padding: 0; background: none; cursor: pointer; text-align: left; color: #F4EDEA; display: flex; flex-direction: column; gap: 6px; }
  .lp-gw__pick img { display: block; width: 100%; aspect-ratio: 3 / 4; object-fit: cover; border: 3px solid #0F0B0D; outline: 1px solid rgba(244, 237, 234, 0.16); transition: outline-color 0.25s, transform 0.25s; }
  .lp-gw__pick:hover img { outline-color: var(--lp-cobalt-bright, #E4A7B6); transform: translateY(-2px); }
  .lp-gw__pick-title { font-size: 0.6875rem; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .lp-gw__pick-price { font-family: var(--font-subheading--family); font-size: 0.625rem; letter-spacing: 0.06em; color: var(--lp-cobalt-bright, #E4A7B6); }
  .lp-gw__summary { margin-top: 22px; border: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent); border-radius: 14px; padding: 16px 18px; }
  .lp-gw__rows { display: flex; flex-direction: column; gap: 10px; margin-bottom: 14px; }
  .lp-gw__row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .lp-gw__row-title { flex: 1 1 160px; font-size: 0.875rem; font-weight: 600; min-width: 0; }
  .lp-gw__row select { flex: 0 1 220px; padding: 9px 12px; border-radius: 9px; border: 1.5px solid color-mix(in srgb, var(--color-foreground) 18%, transparent); background: color-mix(in srgb, var(--color-foreground) 4%, transparent); color: var(--color-foreground); font: inherit; font-size: 0.8125rem; }
  .lp-gw__row-price { font-variant-numeric: tabular-nums; font-size: 0.875rem; font-weight: 650; }
  .lp-gw__foot { display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; border-top: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent); padding-top: 14px; }
  .lp-gw__total { font-size: 0.9375rem; }
  .lp-gw__total strong { font-size: 1.25rem; font-variant-numeric: tabular-nums; margin-left: 6px; }
  .lp-gw__cta[disabled] { opacity: 0.45; cursor: not-allowed; }
  .lp-gw__note { margin: 12px 0 0; font-size: 0.75rem; color: color-mix(in srgb, var(--color-foreground) 55%, transparent); }
  .lp-gw__status { margin: 14px 0 0; text-align: center; font-size: 0.875rem; color: var(--lp-cobalt-bright, #E4A7B6); min-height: 1.2em; }
  @media (max-width: 599px) {
    .lp-gw__wall { aspect-ratio: 4 / 3.4; }
    .lp-gw__picker { inset: 3%; }
  }
</style>

<script>
  (function () {
    'use strict';
    var euro = function (cents) { return (cents / 100).toFixed(2).replace('.', ',') + ' €'; };
    var LAYOUT_SLOTS = { row2: 2, row3: 3, grid4: 4 };

    var setup = function () {
      document.querySelectorAll('[data-lp-gw]:not([data-lp-gw-init])').forEach(function (root) {
        root.setAttribute('data-lp-gw-init', '');
        var dataEl = root.querySelector('[data-lp-gw-data]');
        var wall = root.querySelector('[data-lp-gw-wall]');
        var slotsEl = root.querySelector('[data-lp-gw-slots]');
        var picker = root.querySelector('[data-lp-gw-picker]');
        var pickerGrid = root.querySelector('[data-lp-gw-picker-grid]');
        var rowsEl = root.querySelector('[data-lp-gw-rows]');
        var summary = root.querySelector('[data-lp-gw-summary]');
        var totalEl = root.querySelector('[data-lp-gw-total]');
        var addBtn = root.querySelector('[data-lp-gw-add]');
        var statusEl = root.querySelector('[data-lp-gw-status]');
        if (!dataEl || !wall || !slotsEl || !picker || !pickerGrid || !rowsEl || !addBtn) return;

        var products = [];
        try { products = JSON.parse(dataEl.textContent) || []; } catch (e) { products = []; }
        if (!products.length) {
          if (statusEl) statusEl.textContent = 'Gerade keine Poster verfügbar — schau gleich nochmal vorbei.';
          return;
        }

        var layout = 'row2';
        var slots = [];      /* je Slot: null oder { productIndex, variantIndex } */
        var activeSlot = -1;
        var busy = false;

        function setStatus(msg) { if (statusEl) statusEl.textContent = msg || ''; }

        function openPicker(slotIndex) {
          activeSlot = slotIndex;
          picker.hidden = false;
          var firstBtn = pickerGrid.querySelector('button');
          if (firstBtn) firstBtn.focus();
        }
        function closePicker() {
          picker.hidden = true;
          activeSlot = -1;
        }

        function renderSlots() {
          wall.className = 'lp-gw__wall lp-gw__wall--' + layout;
          slotsEl.textContent = '';
          slots.forEach(function (entry, i) {
            var slot = document.createElement('button');
            slot.type = 'button';
            slot.className = 'lp-gw__slot' + (entry ? ' lp-gw__slot--filled' : '');
            slot.setAttribute('aria-label', entry ? products[entry.productIndex].title + ' — Poster tauschen' : 'Platz ' + (i + 1) + ' füllen');
            if (entry) {
              var img = document.createElement('img');
              img.src = products[entry.productIndex].image;
              img.alt = '';
              img.loading = 'lazy';
              slot.appendChild(img);
              var x = document.createElement('span');
              x.className = 'lp-gw__slot-x';
              x.textContent = '✕';
              x.setAttribute('role', 'button');
              x.setAttribute('aria-label', 'Poster entfernen');
              x.addEventListener('click', function (e) {
                e.stopPropagation();
                slots[i] = null;
                renderSlots(); renderSummary();
              });
              slot.appendChild(x);
            } else {
              var plus = document.createElement('span');
              plus.className = 'lp-gw__slot-plus';
              plus.textContent = '+';
              slot.appendChild(plus);
            }
            slot.addEventListener('click', function () { openPicker(i); });
            slotsEl.appendChild(slot);
          });
        }

        function renderSummary() {
          rowsEl.textContent = '';
          var filled = 0;
          var total = 0;
          slots.forEach(function (entry, i) {
            if (!entry) return;
            filled++;
            var p = products[entry.productIndex];
            var v = p.variants[entry.variantIndex] || p.variants[0];
            total += v ? v.price : 0;
            var row = document.createElement('div');
            row.className = 'lp-gw__row';
            var title = document.createElement('span');
            title.className = 'lp-gw__row-title';
            title.textContent = p.title;
            var select = document.createElement('select');
            select.setAttribute('aria-label', 'Größe für ' + p.title);
            p.variants.forEach(function (variant, vi) {
              var opt = document.createElement('option');
              opt.value = String(vi);
              opt.textContent = variant.title + ' · ' + euro(variant.price);
              if (vi === entry.variantIndex) opt.selected = true;
              select.appendChild(opt);
            });
            select.addEventListener('change', function () {
              entry.variantIndex = parseInt(select.value, 10) || 0;
              renderSummary();
            });
            var price = document.createElement('span');
            price.className = 'lp-gw__row-price';
            price.textContent = v ? euro(v.price) : '';
            row.appendChild(title); row.appendChild(select); row.appendChild(price);
            rowsEl.appendChild(row);
          });
          if (summary) summary.hidden = filled === 0;
          if (totalEl) totalEl.textContent = euro(total);
          addBtn.disabled = filled === 0 || busy;
          addBtn.textContent = filled > 0 ? 'Wand in den Warenkorb (' + filled + ')' : 'Wand in den Warenkorb';
        }

        function setLayout(next) {
          layout = next;
          var count = LAYOUT_SLOTS[layout] || 2;
          var kept = slots.filter(Boolean).slice(0, count);
          slots = [];
          for (var i = 0; i < count; i++) slots.push(kept[i] || null);
          root.querySelectorAll('[data-lp-gw-layout]').forEach(function (btn) {
            btn.setAttribute('aria-pressed', btn.getAttribute('data-lp-gw-layout') === layout ? 'true' : 'false');
          });
          closePicker();
          renderSlots(); renderSummary();
        }

        /* Picker einmalig befüllen */
        products.forEach(function (p, pi) {
          var pick = document.createElement('button');
          pick.type = 'button';
          pick.className = 'lp-gw__pick';
          var img = document.createElement('img');
          img.src = p.image;
          img.alt = '';
          img.loading = 'lazy';
          var t = document.createElement('span');
          t.className = 'lp-gw__pick-title';
          t.textContent = p.title;
          var pr = document.createElement('span');
          pr.className = 'lp-gw__pick-price';
          pr.textContent = p.variants.length ? 'ab ' + euro(p.variants[0].price) : '';
          pick.appendChild(img); pick.appendChild(t); pick.appendChild(pr);
          pick.addEventListener('click', function () {
            if (activeSlot < 0) return;
            slots[activeSlot] = { productIndex: pi, variantIndex: 0 };
            closePicker();
            renderSlots(); renderSummary();
          });
          pickerGrid.appendChild(pick);
        });

        root.querySelectorAll('[data-lp-gw-layout]').forEach(function (btn) {
          btn.addEventListener('click', function () { setLayout(btn.getAttribute('data-lp-gw-layout')); });
        });
        var closeBtn = root.querySelector('[data-lp-gw-picker-close]');
        if (closeBtn) closeBtn.addEventListener('click', closePicker);
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && !picker.hidden) closePicker();
        });

        addBtn.addEventListener('click', function () {
          if (busy) return;
          var items = [];
          slots.forEach(function (entry) {
            if (!entry) return;
            var p = products[entry.productIndex];
            var v = p.variants[entry.variantIndex] || p.variants[0];
            if (v) items.push({ id: v.id, quantity: 1 });
          });
          if (!items.length) return;
          busy = true;
          addBtn.disabled = true;
          setStatus('Wird in den Warenkorb gelegt …');
          fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ items: items })
          }).then(function (res) {
            if (!res.ok) throw new Error('cart');
            setStatus('🎉 Deine Wand ist im Warenkorb!');
            if (typeof window.LimitlessToast === 'function') window.LimitlessToast('Deine Wand ist im Warenkorb', 'success');
            setTimeout(function () { window.location.href = '/cart'; }, 700);
          }).catch(function () {
            busy = false;
            addBtn.disabled = false;
            setStatus('Das hat nicht geklappt — bitte versuch es nochmal.');
            if (typeof window.LimitlessToast === 'function') window.LimitlessToast('Das hat nicht geklappt. Bitte nochmal versuchen.', 'error');
          });
        });

        setLayout('row2');
      });
    };
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setup);
    } else {
      setup();
    }
    document.addEventListener('shopify:section:load', setup);
  })();
</script>

{% schema %}
{
  "name": "Gallery-Wall-Konfigurator",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "GALLERY WALL" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Stell dir deine Wand zusammen." },
    { "type": "text", "id": "subheading", "label": "Unterzeile", "default": "Layout wählen, Plätze füllen, Größen anpassen — und die komplette Wand mit einem Klick in den Warenkorb." },
    { "type": "collection", "id": "collection", "label": "Kollektion (Posterauswahl)" },
    { "type": "text", "id": "note", "label": "Hinweis", "default": "Tipp: Zwei Poster wirken auf gleicher Höhe mit ca. 10 cm Abstand am stärksten." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Farbschema", "default": "scheme-1" },
    { "type": "range", "id": "padding-block-start", "label": "Abstand oben", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding-block-end", "label": "Abstand unten", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 88 }
  ],
  "presets": [{ "name": "Gallery-Wall-Konfigurator" }]
}
{% endschema %}
