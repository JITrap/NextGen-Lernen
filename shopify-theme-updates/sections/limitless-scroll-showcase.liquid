{%- assign sp = section.settings.product -%}

<div
  class="lp-scrollshow spacing-style color-{{ section.settings.color_scheme }}"
  data-lp-scrollshow
  style="--lp-show-h: {{ section.settings.section_height }}vh;"
>
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <div class="lp-scrollshow__sticky">
    <div class="lp-scrollshow__head">
      <div class="lp-scrollshow__eyebrow">{{ section.settings.eyebrow | escape }}</div>
      <h2 class="lp-scrollshow__heading">{{ section.settings.heading | escape }}</h2>
    </div>

    <a
      class="lp-scrollshow__poster"
      {% if sp != blank %}href="{{ sp.url }}"{% endif %}
      aria-label="{{ sp.title | default: 'Poster' | escape }}"
    >
      <span class="lp-scrollshow__frame">
        {%- if sp != blank and sp.media.size > 0 -%}
          {% render 'limitless-media', product: sp, kind: 'hero', preset: 'tight', width: 1400, widths: '600, 900, 1400', class: 'lp-scrollshow__img', loading: 'lazy' %}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'lp-scrollshow__img' }}
        {%- endif -%}
      </span>
      <svg class="lp-scrollshow__fd" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><rect x="0.75" y="0.75" width="98.5" height="98.5" pathLength="1"/></svg>
    </a>

    <div class="lp-scrollshow__cap lp-scrollshow__cap--1">{{ section.settings.text_1 }}</div>
    <div class="lp-scrollshow__cap lp-scrollshow__cap--2">{{ section.settings.text_2 }}</div>
    <div class="lp-scrollshow__bottom">
      <div class="lp-scrollshow__cap lp-scrollshow__cap--3">{{ section.settings.text_3 }}</div>
      {%- if sp != blank -%}
        <a class="button-secondary lp-scrollshow__cta" href="{{ sp.url }}">{{ section.settings.cta_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .lp-scrollshow { position: relative; }
  .lp-scrollshow--active { height: var(--lp-show-h, 300vh); }
  .lp-scrollshow__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    display: grid;
    place-items: center;
    padding: 24px;
  }
  .lp-scrollshow:not(.lp-scrollshow--active) .lp-scrollshow__sticky { position: static; height: auto; padding: 64px 24px; }
  .lp-scrollshow__head {
    position: absolute;
    top: clamp(96px, 12svh, 140px);
    left: 0;
    right: 0;
    text-align: center;
    z-index: 3;
    pointer-events: none;
  }
  .lp-scrollshow__eyebrow {
    font-family: var(--font-subheading--family);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(from var(--color-foreground) r g b / 70%);
    margin-bottom: 10px;
  }
  .lp-scrollshow__heading {
    font-family: var(--font-accent--family);
    letter-spacing: -0.015em;
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    margin: 0;
    color: var(--color-foreground-heading, var(--color-foreground));
  }
  .lp-scrollshow__poster {
    position: relative;
    display: block;
    height: min(62svh, 620px);
    aspect-ratio: 2 / 3;
    z-index: 2;
    transform: translateY(var(--lp-ty, 0vh)) rotate(var(--lp-rot, 0deg)) scale(var(--lp-scale, 1));
    will-change: transform;
  }
  .lp-scrollshow__frame {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    background: #0B0B0C;
    padding: clamp(8px, 1vw, 14px);
    box-shadow: 0 30px 60px rgba(11, 11, 12, 0.28);
  }
  .lp-scrollshow__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .lp-scrollshow__fd {
    position: absolute;
    inset: -16px;
    width: calc(100% + 32px);
    height: calc(100% + 32px);
    color: var(--lp-cobalt, #A32235);
    pointer-events: none;
  }
  .lp-scrollshow__fd rect {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: var(--lp-fd, 0);
  }
  .lp-scrollshow__cap {
    position: absolute;
    max-width: 220px;
    font-size: 0.9375rem;
    line-height: 1.5;
    z-index: 3;
  }
  .lp-scrollshow__cap--1 { left: max(6%, 24px); top: 44%; opacity: var(--lp-c1, 1); transform: translateY(calc((1 - var(--lp-c1, 1)) * 14px)); }
  .lp-scrollshow__cap--2 { right: max(6%, 24px); top: 52%; text-align: right; opacity: var(--lp-c2, 1); transform: translateY(calc((1 - var(--lp-c2, 1)) * 14px)); }
  .lp-scrollshow__bottom {
    position: absolute;
    bottom: clamp(20px, 5svh, 48px);
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    z-index: 3;
    opacity: var(--lp-c3, 1);
    transform: translateY(calc((1 - var(--lp-c3, 1)) * 14px));
  }
  .lp-scrollshow__cap--3 { position: static; max-width: 340px; text-align: center; opacity: 1; transform: none; }
  .lp-scrollshow__cap p { margin: 0; }
  @media (max-width: 749px) {
    .lp-scrollshow__cap--1, .lp-scrollshow__cap--2 { display: none; }
    .lp-scrollshow__poster { height: min(56svh, 480px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .lp-scrollshow--active { height: auto; }
    .lp-scrollshow--active .lp-scrollshow__sticky { position: static; height: auto; padding: 64px 24px; }
    .lp-scrollshow__poster { transform: none !important; }
    .lp-scrollshow__cap, .lp-scrollshow__bottom { opacity: 1 !important; transform: none !important; }
    .lp-scrollshow__fd rect { stroke-dashoffset: 0 !important; }
  }
</style>

<script>
  (function () {
    var setup = function () {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      document.querySelectorAll('[data-lp-scrollshow]:not([data-lp-init])').forEach(function (wrap) {
        wrap.setAttribute('data-lp-init', '');
        wrap.classList.add('lp-scrollshow--active');
        var sticky = wrap.querySelector('.lp-scrollshow__sticky');
        if (!sticky) return;
        var clamp = function (v, a, b) { return Math.max(a, Math.min(b, v)); };
        var seg = function (p, a, b) { return clamp((p - a) / (b - a), 0, 1); };
        var ticking = false;
        var update = function () {
          ticking = false;
          var rect = wrap.getBoundingClientRect();
          var total = rect.height - window.innerHeight;
          var p = total > 0 ? clamp(-rect.top / total, 0, 1) : 1;
          var enter = seg(p, 0, 0.55);
          var exit = seg(p, 0.62, 1);
          var ease = 1 - Math.pow(1 - enter, 3);
          var s = sticky.style;
          s.setProperty('--lp-ty', ((1 - ease) * 14 - exit * 8).toFixed(2) + 'vh');
          s.setProperty('--lp-rot', (-8 * (1 - ease) + 2 * ease * (1 - exit)).toFixed(2) + 'deg');
          s.setProperty('--lp-scale', (0.8 + 0.2 * ease - 0.06 * exit).toFixed(3));
          s.setProperty('--lp-fd', (1 - seg(p, 0.02, 0.5)).toFixed(3));
          s.setProperty('--lp-c1', (seg(p, 0.06, 0.18) - seg(p, 0.4, 0.52)).toFixed(3));
          s.setProperty('--lp-c2', (seg(p, 0.38, 0.5) - seg(p, 0.68, 0.8)).toFixed(3));
          s.setProperty('--lp-c3', seg(p, 0.66, 0.8).toFixed(3));
        };
        var onScroll = function () { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        update();
      });
    };
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setup);
    } else {
      setup();
    }
    document.addEventListener('shopify:section:load', setup);
  })();
</script>

{% schema %}
{
  "name": "Scroll-Showcase",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "product", "id": "product", "label": "Poster" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "NEW DROP" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Ein Motiv. Deine Wand." },
    { "type": "richtext", "id": "text_1", "label": "Text links", "default": "<p>Museumsqualität auf mattem Archivpapier — farbecht und vergilbungsbeständig.</p>" },
    { "type": "richtext", "id": "text_2", "label": "Text rechts", "default": "<p>Klarer schwarzer Rahmen mit bruchsicherer Front — sofort aufhängbar.</p>" },
    { "type": "richtext", "id": "text_3", "label": "Text unten", "default": "<p>Sorgfältig verpackt, gedruckt & versendet aus der EU.</p>" },
    { "type": "text", "id": "cta_label", "label": "Button-Text", "default": "Zum Poster" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Farbschema", "default": "scheme-2" },
    { "type": "range", "id": "section_height", "label": "Scroll-Länge", "min": 200, "max": 400, "step": 50, "unit": "vh", "default": 300 }
  ],
  "presets": [{ "name": "Scroll-Showcase" }]
}
{% endschema %}
